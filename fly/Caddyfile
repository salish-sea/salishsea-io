# The salishsea-io Fly app's web server (decision 056, salish-t3g.3). Fly
# terminates TLS in front of it, so it speaks plain HTTP on 8080.
{
	admin off
	auto_https off
}

:8080 {
	encode zstd gzip

	# The read-path files, on the volume, rewritten hourly. no-cache: a browser
	# may keep a copy but must revalidate it, or it would keep showing a sighting
	# that has since been deleted. A missing day is a real 404, which the frontend
	# reads as a day with no sightings.
	handle_path /read-path/* {
		root * /data/export
		header Cache-Control "no-cache"
		file_server
	}

	handle {
		root * /app/dist

		# Profile pages are client-rendered from their HTML shells (decisions 015,
		# 034). On AWS the Lambda@Edge viewer-request function does this; the
		# patterns are vite.config.js's PROFILE_REWRITES.
		@individual path_regexp ^/individuals/[^/]+(/[^/]*)?/?$
		rewrite @individual /individual.html
		@matriline path_regexp ^/matrilines/[^/]+(/[^/]*)?/?$
		rewrite @matriline /matriline.html
		@ecotype path_regexp ^/ecotypes/[^/]+(/[^/]*)?/?$
		rewrite @ecotype /ecotype.html
		@haulout path_regexp ^/haulouts/[^/]+(/[^/]*)?/?$
		rewrite @haulout /haulout.html

		# Content-hashed, so never stale; everything else revalidates, as the AWS
		# deploy's S3 sync sets it.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@unhashed not path /assets/*
		header @unhashed Cache-Control "no-cache"

		file_server
	}
}

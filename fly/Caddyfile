# The salishsea-io Fly app's web server (decision 056, salish-t3g.3). Fly
# terminates TLS in front of it, so it speaks plain HTTP on 8080.
{
	admin off
	auto_https off
}

# A prerendered page, for the paths args[1] matches: capture 1 is the kind
# (profiles/<kind>/ in the export), capture 2 the page's id.
(prerendered) {
	@{args[0]} path_regexp {args[0]} {args[1]}
	handle @{args[0]} {
		header Cache-Control "no-cache"
		root * /data/export/profiles
		@{args[0]}Published file /{re.{args[0]}.1}/{re.{args[0]}.2}.html
		handle @{args[0]}Published {
			rewrite * /{re.{args[0]}.1}/{re.{args[0]}.2}.html
			file_server
		}
		handle {
			root * /app/dist
			rewrite * /not-published.html
			file_server {
				status 404
			}
		}
	}
}

:8080 {
	encode zstd gzip

	# The write API (decision 065, api/server.ts): what users write, behind a session it
	# issues itself. Only runs with API_ENABLED (fly/start.sh); until then this answers
	# 502. It sets its own Cache-Control.
	handle /api/* {
		reverse_proxy 127.0.0.1:8082
	}

	# The read-path files, on the volume, rewritten hourly. no-cache: a browser
	# may keep a copy but must revalidate it, or it would keep showing a sighting
	# that has since been deleted. A missing day is a real 404, which the frontend
	# reads as a day with no sightings.
	handle_path /read-path/* {
		root * /data/export
		header Cache-Control "no-cache"
		file_server
	}

	# The Darwin Core archive GBIF crawls, its GeoParquet sidecar and their checksums,
	# written by the read-path build (scripts/read-path/dwca.ts, salish-xv35.9) at the
	# paths the nightly workflow published them under. no-cache: rebuilt whenever its data
	# or the date moves.
	handle_path /dwca/* {
		header Cache-Control "no-cache"
		root * /data/export/dwca
		file_server
	}

	# The build's ingest run log (scripts/read-path/ingest-runs.ts), which the heartbeat
	# workflow reads (scripts/ingest/heartbeat.ts). Beside the mirrors, outside the
	# export, so it is never a published file; no-cache, since its age is the point.
	handle /status/ingest-runs.json {
		header Cache-Control "no-cache"
		root * /data/mirrors
		rewrite * /ingest-runs.json
		file_server
	}

	# The Maplify name guard's baseline: every (name, scientific name) pair the last
	# passing build resolved, and to what (salish-xv35.9.2). register-refresh.yml reads
	# it before loading an edition, to refuse one that would un-name any of them.
	handle /status/maplify-names.json {
		header Cache-Control "no-cache"
		root * /data/mirrors
		rewrite * /maplify-names.json
		file_server
	}

	# Present only while the machine is in maintenance mode (fly/start.sh): the builds
	# are paused on purpose, since when. The heartbeat reads it before calling the
	# build stale; a 404 means builds are running. (salish-xv35.24)
	handle /status/maintenance.json {
		header Cache-Control "no-cache"
		root * /data/mirrors
		rewrite * /maintenance.json
		file_server
	}

	# A bare identifier (/individuals/0010193, /haulouts/340): decision 034 301s it to
	# the slugged address. The redirect server answers from the map the build writes,
	# with no lookup; an identifier it doesn't know has no published page, which is the
	# same 404 the prerendered route below gives. Before that route, which would
	# otherwise serve the page at the bare address.
	@bareId path_regexp bareId ^/((individuals|matrilines|ecotypes)/[0-9]{7}|haulouts/[0-9]{1,9})/?$
	handle @bareId {
		reverse_proxy 127.0.0.1:8081 {
			@unpublished status 404
			handle_response @unpublished {
				header Cache-Control "no-cache"
				root * /app/dist
				rewrite * /not-published.html
				file_server {
					status 404
				}
			}
		}
	}

	# A profile page prerendered by the read-path build (decision 057): an
	# individual, a matriline or an ecotype by its register identifier's seven
	# digits, or a haul-out site by its id. The slug after them is ignored, as
	# the client pages ignore it. A page the build hasn't written yet is a real
	# 404 saying so. Designation-shaped paths (/individuals/J35, legacy links)
	# don't match, and stay on the client-rendered shells below.
	import prerendered animalPage ^/(individuals|matrilines|ecotypes)/([0-9]{7})(/[^/]*)?/?$
	import prerendered sitePage ^/(haulouts)/([0-9]{1,9})(/[^/]*)?/?$

	# A designation (/individuals/T65A, /matrilines/T065As, /ecotypes/Biggs):
	# legacy links from before decision 034, and typed ones. The redirect server
	# (scripts/read-path/redirect.ts) folds it and 301s to the canonical page from
	# the map the build writes, with no database lookup; a designation no profile
	# answers to is a 404 saying so (decision 057, step 5). After the routes
	# above, which a seven-digit identifier matches first.
	@designation path_regexp designation ^/(individuals|matrilines|ecotypes)/[^/]+/?$
	handle @designation {
		reverse_proxy 127.0.0.1:8081 {
			@unknown status 404
			handle_response @unknown {
				# A later build may add the designation: never reuse this answer unasked.
				header Cache-Control "no-cache"
				root * /app/dist
				rewrite * /not-in-catalog.html
				file_server {
					status 404
				}
			}
		}
	}

	# The sitemap the build writes, with every profile in it; the site's own,
	# from the image, until the first build has run.
	handle /sitemap.xml {
		header Cache-Control "no-cache"
		root * /data/export
		@built file
		handle @built {
			file_server
		}
		handle {
			root * /app/dist
			file_server
		}
	}

	handle {
		root * /app/dist

		# Profile pages are client-rendered from their HTML shells (decisions 015,
		# 034), except the pages the build has prerendered, above. On
		# AWS the Lambda@Edge viewer-request function does this; the patterns are
		# vite.config.js's PROFILE_REWRITES.
		@individual path_regexp ^/individuals/[^/]+(/[^/]*)?/?$
		rewrite @individual /individual.html
		@matriline path_regexp ^/matrilines/[^/]+(/[^/]*)?/?$
		rewrite @matriline /matriline.html
		@ecotype path_regexp ^/ecotypes/[^/]+(/[^/]*)?/?$
		rewrite @ecotype /ecotype.html
		@haulout path_regexp ^/haulouts/[^/]+(/[^/]*)?/?$
		rewrite @haulout /haulout.html

		# Content-hashed, so never stale; everything else revalidates, as the AWS
		# deploy's S3 sync sets it.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@unhashed not path /assets/*
		header @unhashed Cache-Control "no-cache"

		file_server
	}
}

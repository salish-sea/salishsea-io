{
  "name": "salishsea-io",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^24.10"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build": "tsc && vite build && html-validate dist/**/*.html",
    "build:dwca": "tsx scripts/dwca/build.ts",
    "build:size": "vite build",
    "dev": "vite dev",
    "gen-types": "supabase gen types --local --schema public --schema graphql_public > database.types.ts",
    "preview": "vite preview",
    "seed:biggs": "tsx scripts/seed/seed-biggs.ts",
    "test": "vitest"
  },
  "dependencies": {
    "@formatjs/intl-datetimeformat": "^7.6.0",
    "@lit/context": "^1.1.6",
    "@lit/task": "1.0.3",
    "@sentry/browser": "^10.70.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@supabase/auth-js": "^2.112.3",
    "@supabase/sentry-js-integration": "^0.3.0",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/lit-form": "^1.25.5",
    "@turf/bearing": "^7.4.0",
    "@turf/distance": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "dompurify": "^3.4.14",
    "exifreader": "^4.44.0",
    "fast-xml-parser": "5.11.0",
    "geo-coordinates-parser": "^1.7.4",
    "lit": "^3.3.3",
    "marked": "18.0.10",
    "ol": "^10.10.0",
    "temporal-polyfill": "^0.3",
    "uuid": "^14.0.2",
    "vite": "^8.2.2",
    "zod": "^4.3.6"
  },
  "size-limit": [
    {
      "name": "JS",
      "path": "dist/assets/*.js"
    },
    {
      "name": "CSS",
      "path": "dist/assets/*.css"
    }
  ],
  "devDependencies": {
    "@duckdb/node-api": "1.5.4-r.1",
    "@playwright/test": "^1.62.1",
    "@size-limit/file": "^13.0.3",
    "@types/geojson": "^7946.0.16",
    "@types/google.accounts": "^0.0.18",
    "@types/jsdom": "^30.0.0",
    "html-validate": "^11.9.0",
    "jsdom": "^30.0.1",
    "postgres": "^3.4.9",
    "size-limit": "^13.0.3",
    "supabase": "^2.115.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "type-fest": "^5.8.0",
    "typescript": "~7.0.2",
    "vitest": "^4.1.11",
    "yazl": "3.3.1"
  }
